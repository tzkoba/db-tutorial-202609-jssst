# Shared settings for YugabyteDB availability/reliability demo
# Image tag is pinned for lecture reproducibility (override with YB_IMAGE=...).
export YB_IMAGE="${YB_IMAGE:-yugabytedb/yugabyte:2024.2.2.1-b6}"
export YB_NETWORK="${YB_NETWORK:-yb-demo-net}"
export YB1="${YB1:-yb1}"
export YB2="${YB2:-yb2}"
export YB3="${YB3:-yb3}"
# Host-mapped YSQL ports (avoid clash with PostgreSQL demos on 5432)
export YB1_YSQL_PORT="${YB1_YSQL_PORT:-5433}"
export YB2_YSQL_PORT="${YB2_YSQL_PORT:-5434}"
export YB3_YSQL_PORT="${YB3_YSQL_PORT:-5435}"
# Master UI / TServer UI / YugabyteDB UI (optional host maps)
export YB1_MASTER_UI_PORT="${YB1_MASTER_UI_PORT:-7001}"
export YB2_MASTER_UI_PORT="${YB2_MASTER_UI_PORT:-7002}"
export YB3_MASTER_UI_PORT="${YB3_MASTER_UI_PORT:-7003}"
export YB1_TSERVER_UI_PORT="${YB1_TSERVER_UI_PORT:-9001}"
export YB2_TSERVER_UI_PORT="${YB2_TSERVER_UI_PORT:-9002}"
export YB3_TSERVER_UI_PORT="${YB3_TSERVER_UI_PORT:-9003}"
export YB_DB="${YB_DB:-yugabyte}"
export YB_USER="${YB_USER:-yugabyte}"
export YB_TABLE="${YB_TABLE:-demo_writes}"
# Phase 5: two non-colocated tables (one tablet each) so each has its own Raft leader.
export YB_TXN_T1="${YB_TXN_T1:-demo_txn_orders}"
export YB_TXN_T2="${YB_TXN_T2:-demo_txn_lines}"
export YB_BASE_DIR="${YB_BASE_DIR:-/home/yugabyte/yb_data}"
# Rough RAM hint for preflight (MB). Official guidance is ~2GB per node × 3.
export YB_MIN_AVAIL_MB="${YB_MIN_AVAIL_MB:-5500}"
export DEMO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export RUN_DIR="${RUN_DIR:-${DEMO_DIR}/.run}"
