# Shared settings for reliability demo scripts
export PG_IMAGE="${PG_IMAGE:-postgres:18}"
# postgres:18+ official image: mount /var/lib/postgresql (not .../data).
# Cluster files live in $PG_DATA_DIR. See docker-library/postgres#1259.
export PG_VOLUME_MOUNT="${PG_VOLUME_MOUNT:-/var/lib/postgresql}"
export PG_DATA_DIR="${PG_DATA_DIR:-/var/lib/postgresql/18/docker}"
export PG_CONTAINER="${PG_CONTAINER:-pg-reliability}"
export PG_PITR_CONTAINER="${PG_PITR_CONTAINER:-pg-reliability-pitr}"
export PG_PORT="${PG_PORT:-5434}"
export PG_PITR_PORT="${PG_PITR_PORT:-5435}"
export PG_DATA_VOLUME="${PG_DATA_VOLUME:-pg-reliability-data}"
export PG_PITR_DATA_VOLUME="${PG_PITR_DATA_VOLUME:-pg-reliability-pitr-data}"
export PG_ARCHIVE_VOLUME="${PG_ARCHIVE_VOLUME:-pg-wal-archive}"
export PG_BACKUP_VOLUME="${PG_BACKUP_VOLUME:-pg-basebackup}"
export PG_SUPERUSER="${PG_SUPERUSER:-postgres}"
export PG_SUPERUSER_PASSWORD="${PG_SUPERUSER_PASSWORD:-postgres}"
