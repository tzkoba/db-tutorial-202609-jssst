# Shared settings for demo scripts
export PG_IMAGE="${PG_IMAGE:-postgres:18}"
# postgres:18+ official image: mount /var/lib/postgresql (not .../data).
# Cluster files live in $PG_DATA_DIR. See docker-library/postgres#1259.
export PG_VOLUME_MOUNT="${PG_VOLUME_MOUNT:-/var/lib/postgresql}"
export PG_DATA_DIR="${PG_DATA_DIR:-/var/lib/postgresql/18/docker}"
export PG_NETWORK="${PG_NETWORK:-pgnet}"
export PG_PRIMARY="${PG_PRIMARY:-pg-primary}"
export PG_STANDBY="${PG_STANDBY:-pg-standby}"
export PG_PRIMARY_PORT="${PG_PRIMARY_PORT:-5432}"
export PG_STANDBY_PORT="${PG_STANDBY_PORT:-5433}"
export PG_PRIMARY_VOLUME="${PG_PRIMARY_VOLUME:-pg-primary-data}"
export PG_STANDBY_VOLUME="${PG_STANDBY_VOLUME:-pg-standby-data}"
export PG_SUPERUSER="${PG_SUPERUSER:-postgres}"
export PG_SUPERUSER_PASSWORD="${PG_SUPERUSER_PASSWORD:-postgres}"
export PG_REPL_USER="${PG_REPL_USER:-replicator}"
export PG_REPL_PASSWORD="${PG_REPL_PASSWORD:-replicator}"
export PG_REPL_SLOT="${PG_REPL_SLOT:-standby_slot}"
