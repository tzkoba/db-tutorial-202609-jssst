# Shared settings for MongoDB availability/consistency demo
export MONGO_IMAGE="${MONGO_IMAGE:-mongo:8}"
export MONGO_NETWORK="${MONGO_NETWORK:-mongo-demo-net}"
export MONGO_RS="${MONGO_RS:-rs0}"
export MONGO1="${MONGO1:-mongo1}"
export MONGO2="${MONGO2:-mongo2}"
export MONGO3="${MONGO3:-mongo3}"
export MONGO1_PORT="${MONGO1_PORT:-27017}"
export MONGO2_PORT="${MONGO2_PORT:-27018}"
export MONGO3_PORT="${MONGO3_PORT:-27019}"
export MONGO_DB="${MONGO_DB:-demo}"
export MONGO_COLL="${MONGO_COLL:-writes}"
export DEMO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export RUN_DIR="${RUN_DIR:-${DEMO_DIR}/.run}"
export URI_HOST="mongodb://host.docker.internal:${MONGO1_PORT},host.docker.internal:${MONGO2_PORT},host.docker.internal:${MONGO3_PORT}/?replicaSet=${MONGO_RS}"
# From inside the docker network, use container hostnames:
export URI_DOCKER="mongodb://${MONGO1}:27017,${MONGO2}:27017,${MONGO3}:27017/?replicaSet=${MONGO_RS}"
