# Shared settings for PostgreSQL jsonb vs MongoDB document demo
export PG_IMAGE="${PG_IMAGE:-postgres:18}"
export MONGO_IMAGE="${MONGO_IMAGE:-mongo:8}"

export DEMO_NETWORK="${DEMO_NETWORK:-json-compare-net}"
export PG_CONTAINER="${PG_CONTAINER:-json-pg}"
export MONGO_CONTAINER="${MONGO_CONTAINER:-json-mongo}"

# Host ports chosen to avoid clashing with other demos (5432 / 27017)
export PG_PORT="${PG_PORT:-15432}"
export MONGO_PORT="${MONGO_PORT:-27027}"

export PG_USER="${PG_USER:-postgres}"
export PG_PASSWORD="${PG_PASSWORD:-postgres}"
export PG_DB="${PG_DB:-json_demo}"

export MONGO_DB="${MONGO_DB:-json_demo}"
export MONGO_COLL="${MONGO_COLL:-orders}"

export DEMO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export DATA_FILE="${DATA_FILE:-${DEMO_DIR}/data/sample-orders.json}"
